<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>SimpleMediator</RootNamespace>
    <!-- Produces SimpleMediator.xml so the doc comments show up in IntelliSense for package users. -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- A library should build cleanly; this also turns a missing public doc comment (CS1591) into an error. -->
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <!-- Lets the test project see internal types such as the handler wrappers. -->
    <InternalsVisibleTo Include="SimpleMediator.Tests" />
  </ItemGroup>

</Project>
