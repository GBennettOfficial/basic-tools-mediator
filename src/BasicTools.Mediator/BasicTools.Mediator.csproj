<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>BasicTools.Mediator</RootNamespace>
    <!-- Produces BasicTools.Mediator.xml so the doc comments show up in IntelliSense for package users. -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- A library should build cleanly; this also turns a missing public doc comment (CS1591) into an error. -->
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <!-- NuGet package metadata. Everything here shows on the package's nuget.org page. -->
  <PropertyGroup>
    <PackageId>BasicTools.Mediator</PackageId>
    <!-- Overridden by the release workflow from the git tag, e.g. tag v1.2.0 packs version 1.2.0. -->
    <Version>0.1.0</Version>
    <Authors>GBennettOfficial</Authors>
    <Description>A small, dependency-light mediator for CQRS: separate commands and queries, notifications with pluggable publishing strategies, pipeline behaviors, and assembly scanning for Microsoft.Extensions.DependencyInjection.</Description>
    <PackageTags>mediator;cqrs;commands;queries;notifications;pipeline;dependency-injection</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageProjectUrl>https://github.com/GBennettOfficial/basic-mediator</PackageProjectUrl>
    <RepositoryUrl>https://github.com/GBennettOfficial/basic-mediator</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <!-- A separate .snupkg with debug symbols, so users can step into the library while debugging. -->
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

  <!-- On CI, make the build reproducible: identical source produces an identical package. -->
  <PropertyGroup Condition="'$(GITHUB_ACTIONS)' == 'true'">
    <ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <!-- Only the abstractions package: it defines IServiceCollection without pulling in a container implementation. -->
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
  </ItemGroup>

  <ItemGroup>
    <!-- Lets the test project see internal types such as the handler wrappers. -->
    <InternalsVisibleTo Include="BasicTools.Mediator.Tests" />
  </ItemGroup>

</Project>
